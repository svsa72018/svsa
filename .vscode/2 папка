def ai_guesses_game():
    print("=== Загадайте число от 1 до 100 в уме, а я попробую его отгадать! ===")
    input("Нажмите Enter, когда будете готовы...")
    
    low = 1
    high = 100
    attempts = 0

    while low <= high:
        guess = (low + high) // 2
        attempts += 1
        print(f"\nМоя попытка №{attempts}: это число {guess}?")
        feedback = input("Введите 'б' (если больше), 'м' (если меньше) или 'у' (если угадал): ").lower()

        if feedback == 'у':
            print(f"😎 Ура! Я отгадал ваше число за {attempts} попыток!")
            break
        elif feedback == 'б':
            low = guess + 1
        elif feedback == 'м':
            high = guess - 1
        else:
            print("Я вас не понял. Введите 'б', 'м' или 'у'.")

if __name__ == "__main__":
    ai_guesses_game()
